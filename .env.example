# =============================================================================
# Copy to .env for local runs. On Railway, paste these into Variables instead
# (Railway → your service → Variables → Raw Editor) — never commit .env.
# =============================================================================

# --- REQUIRED --------------------------------------------------------------

# From @BotFather on Telegram: /newbot → copy the token.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any OpenAI-compatible provider. Defaults below are NVIDIA NIM (free tier,
# no card required) — get a key at build.nvidia.com.
LLM_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# Alternatives, same three variables — the model MUST support tool calling:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1          LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1            LLM_MODEL=openai/gpt-4o-mini
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1               LLM_MODEL=gpt-4o-mini

# --- STRONGLY RECOMMENDED --------------------------------------------------

# Your numeric Telegram ID. Leave this empty and anyone who finds the bot can
# use your profile, your CV and your Gmail quota. Send /whoami to the bot to
# get yours, then set it here and redeploy. Comma-separate for multiple IDs.
TELEGRAM_ALLOWED_USER_ID=

# --- EMAIL SENDING ---------------------------------------------------------
# Resend sends through HTTPS. Set RESEND_API_KEY in Railway and use a sender
# address that Resend has verified for your account.
RESEND_API_KEY=re_your-key-here
SENDER_EMAIL=you@your-verified-domain.com
SENDER_NAME=Your Name

# --- STORAGE ---------------------------------------------------------------
# On Railway: mount a Volume and set this to its mount path (e.g. /data), or
# your profile edits, conversations and application history vanish on every
# redeploy. The Dockerfile already defaults this to /data.
DATA_DIR=./data
GENERATED_CVS_DIR=/tmp/generated_cvs

# --- TUNING (all optional) -------------------------------------------------
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=90
MAX_TOOL_STEPS=12
MAX_HISTORY_MESSAGES=40
HTTP_TIMEOUT=20
LOG_LEVEL=INFO
ENV=production

# --- LOCAL-ONLY PLAYWRIGHT (leave false on Railway) ------------------------
# Only useful on your own machine with a LinkedIn session already logged into
# ./browser_profile. Requires: pip install playwright && playwright install chromium
ENABLE_PLAYWRIGHT=false
HEADLESS=true
BROWSER_PROFILE_PATH=./browser_profile
LINKEDIN_BASE_URL=https://www.linkedin.com
